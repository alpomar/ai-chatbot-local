meta {
  name: Chat Request (RAG)
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/bot/chat-rag
  body: json
  auth: inherit
}

body:json {
  {
    "prompt_message": "What's the name of the first chapter in the book?",
  "history_id": "1"
  }
}

body:text {
  "Give me the code for Acerra"
}

settings {
  encodeUrl: true
  timeout: 0
}
